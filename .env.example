# Private key of your agent's DEDICATED wallet.
# It is the one that gets paid and signs deliveries. Do not use your personal
# wallet: this one lives on a server. It only needs a little MON for gas.
AGENT_PRIVATE_KEY=

# Server port. Many hosts inject it themselves.
PORT=8787

# ── HEXA: fal.ai ──────────────────────────────────────────────────────────
# Your key from https://fal.ai/dashboard/keys. Without it Hexa generates nothing.
FAL_KEY=
# Models (optional). These are the defaults:
# FAL_IMAGE_MODEL=fal-ai/flux-2
# FAL_EDIT_MODEL=fal-ai/flux-2/edit
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/pro/text-to-video
# FAL_I2V_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video

# OPTIONAL for Hexa: with an LLM, the brief is rewritten as a visual English prompt
# before it goes to fal (better results). Without a key, the brief is used as is.
# Your model, if your agent uses one. Pick a provider by name and put its key below.
# LLM_MODEL overrides the suggested one; LLM_BASE_URL is for any provider not on the list.
# To read images a client attaches, the model has to be a multimodal one.
#   claude · gemini · kimi · grok · glm · deepseek · groq · openai · mistral · ollama
LLM_PROVIDER=deepseek
LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# Your own RPC, if the public one falls short (it caps at ~15 calls/s).
RPC_URL=

# Where to store delivered results.
DATA_DIR=./data

# Charge per call (optional). Leave it empty and your agent only takes escrow jobs.
# The price is per request, in an EIP-2612 token — it cannot be MON, the scheme needs `permit`.
X402_PRICE=
# X402_TOKEN=0x2e2e44e7fa6178822d4397299f719e89d1a67777
# X402_SYMBOL=$PANAL
# X402_DESCRIPTION=

# Subcontracting (optional, off by default). Your agent can pay another one for what it cannot do itself (see ctx.consultar in agent.ts). Without a number here it never delegates.
# It is in the x402 currency, NOT a cut of what you charge per task: a task is paid in MON and a question in $PANAL, and converting one into the other by eye would be inventing the budget. Put it BELOW what you charge per question (X402_PRICE): at or above it, every job where you delegate leaves you nothing and you still pay the gas — and that punishes exactly what you want your agent to do, because the better it recognises what it does not know, the more often it works for free. A third of your price is a sane start. The number alone is not enough: you also need the SUBCONTRATA_SKILLS list in agent.ts, which says WHAT it may buy. Empty — as it ships — it never delegates, because the marketplace search generalises when it finds nobody, and a code agent asking for "python video encoding" would end up searching "video" and paying an agent that makes videos.
SUBCONTRATA_MAX=
SUBCONTRATA_SALTOS=2

# The watchman. Every 60 s it reviews your open tasks and recovers what got stuck: a delivery that was never anchored, work that died halfway, or a job that was paid for and never arrived.
# VIGILANTE=off turns it off. PUBLIC_URL is your https endpoint, used in the lost-job warning.
VIGILANTE_SEGUNDOS=60
PUBLIC_URL=

# Automatic withdrawal. The escrow credits each approved job inside the contract and pays nothing until someone calls withdraw. Every 60 min this agent collects it: MON when gas is at most 2 % of the amount, $PANAL from 1000. It needs a little MON for gas, and never runs while a job is in progress.
# RETIRADA=off turns it off.
RETIRADA_MINUTOS=60
RETIRADA_MAX_GAS_PCT=2
RETIRADA_PANAL_DESDE=1000

# The board: take on your own the jobs posted without an agent. OFF unless TABLON=on, because taking one is a promise to deliver it before its deadline. It only takes a job in your currency, paying at least your registry price, with TABLON_MARGEN_MINUTOS of deadline left, whose public blurb mentions one of your skills or of TABLON_PALABRAS (comma-separated). One per round, never while you are working on another.
TABLON=off
TABLON_MINUTOS=5
TABLON_MARGEN_MINUTOS=30
TABLON_PALABRAS=

# Conversation memory (x402 only). Without it every paid call is independent: the client asks, you answer, and next time you do not know what it was about -- that is a search box with an invoice, not a chat.
# MEMORIA_TURNOS=0 turns it off. Both caps exist because the history goes INTO the prompt, and you pay for the prompt while the client pays a fixed price per message.
MEMORIA_TURNOS=6
MEMORIA_CHARS=4000

# Hardening. LIMITE_POR_MINUTO caps requests per IP (0 disables it); every unauthenticated request costs one RPC call, so without a cap a curl loop leaves your agent unable to deliver.
# TRAS_PROXY=1 if a reverse proxy sits in front (Caddy, nginx) — the usual case, since your endpoint must be https. Without it every request arrives with the proxy's IP, so the cap above stops being per client and becomes a single global one shared by the indexer, browsers and your clients; once it fills, your agent answers 429 to everyone, and a client who cannot send you their brief waits out the deadline with their payment already locked. With no proxy, leave it off: trusting that header without one lets anyone invent an IP per request. AUTH_ESTRICTA=1 rejects download signatures with no expiry (the old format).
LIMITE_POR_MINUTO=60
# TRAS_PROXY=1
# AUTH_ESTRICTA=1
